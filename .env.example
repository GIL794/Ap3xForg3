# Optional: Google Gemini Free API Key (from https://aistudio.google.com/)
VITE_GEMINI_API_KEY=

# Optional: Supabase Cloud Sync (from https://supabase.com/)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-Side Only (Configure in Vercel Project Settings — Never exposed to browser bundle)
# Comma-separated list of revoked athlete IDs, emails, or transaction receipts
REVOKED_ATHLETES=
# Server-side Pro Passcode override (defaults to C0D3T0UNL0CK if unset)
SERVER_PRO_PASSCODE=
# Global Pro Revocation Killswitch (set to true to immediately revoke all non-founder Pro access)
GLOBAL_PRO_REVOKED=false
